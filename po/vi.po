#: ngosen/src/core/ngosen-state-retone.cpp
msgid "Tab or Esc: put back the key"
msgstr "Cứu dấu: Tab hoặc Esc để trả lại phím vừa gõ"

#: ngosen/src/core/ngosen-state-retype.cpp
msgid "Tab or Esc: put back what was typed"
msgstr "Cứu chữ: Tab hoặc Esc để trả lại chữ đã gõ"

#: ngosen/src/core/ngosen-state-retype.cpp
msgid "Enter: retype in Vietnamese, Tab or Esc: keep"
msgstr "Cứu chữ: Enter để đổi, Tab hoặc Esc để giữ nguyên"

#: settings/ngosen_settings/options.py
msgid "Tap the keys together and let go; the tray icon and a short notification show the language."
msgstr "Nhấn cùng lúc rồi thả ra; biểu tượng ở khay và một thông báo ngắn cho biết đang gõ tiếng gì."

#: settings/ngosen_settings/options.py
msgid "The tray menu changes at once, this window the next time it opens."
msgstr "Menu khay đổi ngay, cửa sổ này đổi ở lần mở sau."

#: settings/ngosen_settings/options.py
msgid "A mode picked in the tray menu is kept for the app in use. Pick the app's usual mode again to make it follow the global setting."
msgstr "Chế độ chọn ở menu khay được nhớ cho app đang dùng. Chọn lại chế độ app vẫn dùng để app đó lại theo cài đặt chung."

#: settings/ngosen_settings/options.py
msgid "xin → Xin in an empty field or on a new line. Not in address bars or some apps."
msgstr "xin → Xin ở ô trống hoặc đầu dòng mới. Không áp dụng ở thanh địa chỉ và vài app."

#: settings/ngosen_settings/options.py
msgid "Modes in the tray menu"
msgstr "Chế độ gõ trong menu khay"

#: settings/ngosen_settings/options.py
msgid "Show in the tray menu"
msgstr "Hiện trong menu khay"

#: settings/ngosen_settings/pages.py
msgid "Vietnamese input method for Wayland compositors"
msgstr "Bộ gõ tiếng Việt cho compositor Wayland"

#: settings/ngosen_settings/whats_new.py
msgid "The tray menu"
msgstr "Menu khay"

#: settings/ngosen_settings/whats_new.py
msgid "Click the Ngó Sen icon to switch between English and Vietnamese; its menu picks the mode for the app in use."
msgstr "Bấm biểu tượng Ngó Sen để đổi Anh/Việt; menu của nó chọn chế độ gõ cho app đang dùng."

#: settings/ngosen_settings/whats_new.py
msgid "A capital letter after . ! ? and Enter. Off by default; the tray menu's Auto Capitalize pauses it."
msgstr "Tự viết hoa sau . ! ? và Enter. Mặc định tắt; mục Tự viết hoa trong menu khay tắt tạm."

#: settings/ngosen_settings/whats_new.py
msgid "“Save typing log” in the tray menu records what you type, to attach to a bug report."
msgstr "“Lưu nhật ký gõ” trong menu khay ghi lại chữ gõ, để gửi kèm báo lỗi."
