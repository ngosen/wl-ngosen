msgid "Tip: {}"
msgstr "Mẹo: {}"

#: settings/ngosen_settings/pages.py
#, python-brace-format
msgid "{} words. Search to see them."
msgstr "{} từ. Gõ vào ô tìm để xem."

#: settings/ngosen_settings/pages.py
#, python-brace-format
msgid "Showing {} of {} words found."
msgstr "Đang hiện {} trên {} từ tìm thấy."

#: settings/ngosen_settings/pages.py
msgid "Original Input Method:"
msgstr "Kiểu gõ gốc:"

#: settings/ngosen_settings/pages.py
#, python-brace-format
msgid "{key} already does “{action}”; Update replaces it."
msgstr "{key} đang dùng cho “{action}”; bấm Cập nhật để thay."

#: settings/ngosen_settings/pages.py
#, python-brace-format
msgid "Based on the code of {fork} and {vmk}."
msgstr "Dựa trên mã của {fork} và {vmk}."

#: settings/ngosen_settings/whats_new.py
msgid "Search settings"
msgstr "Tìm cài đặt"

#: settings/ngosen_settings/whats_new.py
msgid "Type in the field above the page list to find a setting; Ctrl+F gets there."
msgstr "Gõ vào ô phía trên danh sách trang để tìm một cài đặt; Ctrl+F đưa tới ô đó."

#: settings/ngosen_settings/whats_new.py
msgid "Tap Ctrl alone to keep the word as typed: tunx, Ctrl, Space keeps tũn."
msgstr "Nhấp thả Ctrl để chốt chữ như đã gõ: tunx, Ctrl, Space giữ tũn."

#: settings/ngosen_settings/whats_new.py
msgid "A macro ko → không also types Không when you type Ko."
msgstr "Gõ tắt ko → không thì gõ Ko ra Không."

#: settings/ngosen_settings/whats_new.py
msgid "] types ư and [ types ơ, so ch]a gives chưa. Off by default."
msgstr "] ra ư, [ ra ơ, nên ch]a ra chưa. Mặc định tắt."

#: settings/ngosen_settings/whats_new.py
msgid "Space twice types a period. Off by default."
msgstr "Bấm Space hai lần ra dấu chấm. Mặc định tắt."

#: settings/ngosen_settings/whats_new.py
msgid "-- types an em dash (—). Off by default."
msgstr "-- ra gạch dài (—). Mặc định tắt."

#: settings/ngosen_settings/whats_new.py
msgid "hoà or hòa? Pick with “Use oà, uý (Instead Of òa, úy)”."
msgstr "hoà hay hòa? Chọn ở ô “Bỏ dấu kiểu mới (oà, uý)”."

#: settings/ngosen_settings/whats_new.py
msgid "$DATE and $TIME in a macro type today's date and time: hn → Hôm nay $DATE."
msgstr "$DATE và $TIME trong gõ tắt ra ngày giờ hôm nay: hn → Hôm nay $DATE."

#: settings/ngosen_settings/whats_new.py
msgid "“Back Up…” and “Restore…” in the window menu keep your settings, macros and dictionary."
