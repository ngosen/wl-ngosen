#: settings/ngosen_settings/backup.py
msgid "A switch key here needs Ctrl, Alt, Shift or Super with another key."
msgstr "Ở bản này, phím chuyển cần Ctrl, Alt, Shift hoặc Super đi kèm một phím khác."

#: settings/ngosen_settings/backup.py
msgid "The settings in the file are damaged."
msgstr "Phần cài đặt trong tệp bị hỏng."

#: settings/ngosen_settings/backup.py
msgid "No settings found in the file."
msgstr "Tệp không có cài đặt nào."

#: settings/ngosen_settings/backup.py
msgid "The dictionary in the file is damaged."
msgstr "Phần từ điển trong tệp bị hỏng."

#: settings/ngosen_settings/backup.py
msgid "The current switch key stays."
msgstr "Giữ phím chuyển Anh/Việt đang dùng."

#: settings/ngosen_settings/backup.py
msgid "The backup was made while typing English, so typing switches to English."
msgstr "Bản sao lưu được tạo lúc đang gõ tiếng Anh, nên Ngó Sen sẽ chuyển sang gõ tiếng Anh."

#: settings/ngosen_settings/backup.py
msgid "Rules that pick emoji for an app are kept but do nothing here."
msgstr "Luật chọn emoji cho từng app vẫn được giữ nhưng bản này không dùng."

#: settings/ngosen_settings/backup.py
msgid "The lists in the file are damaged."
msgstr "Danh sách gõ tắt hoặc bảng phím trong tệp bị hỏng."

#: settings/ngosen_settings/backup.py
msgid "The file holds text that is not valid Unicode."
msgstr "Tệp có chữ không phải Unicode hợp lệ."

#: settings/ngosen_settings/backup.py
msgid "This edition has no emoji picker, so words are underlined instead."
msgstr "Bản này không có bảng chọn emoji, nên chữ sẽ gõ có gạch chân."

#: settings/ngosen_settings/backup.py
#, python-brace-format
msgid "These files could not be put back: {}"
msgstr "Không trả lại được các tệp này: {}"

#: settings/ngosen_settings/backup.py
#, python-brace-format
msgid "These switch keys in the backup are left out: {}. {}"
msgstr "Bỏ qua các phím chuyển Anh/Việt này trong bản sao lưu: {}. {}"

#: settings/ngosen_settings/backup.py
#, python-brace-format
msgid "The backup types in a mode this edition does not know ({}), so the current one stays."
msgstr "Bản sao lưu gõ ở chế độ mà bản này không biết ({}), nên giữ chế độ đang dùng."

#: settings/ngosen_settings/keymap.py
msgid "Remove the tone mark"
msgstr "Xoá dấu thanh"

#: settings/ngosen_settings/keymap.py
msgid "Sắc tone"
msgstr "Dấu sắc"

#: settings/ngosen_settings/keymap.py
msgid "Huyền tone"
msgstr "Dấu huyền"

#: settings/ngosen_settings/keymap.py
msgid "Hỏi tone"
msgstr "Dấu hỏi"

#: settings/ngosen_settings/keymap.py
msgid "Ngã tone"
msgstr "Dấu ngã"

#: settings/ngosen_settings/keymap.py
msgid "Nặng tone"
msgstr "Dấu nặng"

#: settings/ngosen_settings/keymap.py
msgid "Microsoft layout"
msgstr "Bố cục Microsoft"

#: settings/ngosen_settings/keymap.py
msgid "VNI on a French keyboard"
msgstr "VNI bàn phím tiếng Pháp"

#: settings/ngosen_settings/keys.py
msgid "Press at least two keys together."
msgstr "Cần bấm ít nhất hai phím cùng lúc."

#: settings/ngosen_settings/keys.py
msgid "Shift with a key types a capital letter or a symbol."
msgstr "Shift kèm một phím sẽ gõ ra chữ hoa hoặc ký hiệu."

#: settings/ngosen_settings/keys.py
msgid "GNOME already uses these keys."
msgstr "GNOME đã dùng tổ hợp phím này."

#: settings/ngosen_settings/keys.py
msgid "Hold Ctrl, Alt, Shift or Super first, then press the other key."
msgstr "Giữ Ctrl, Alt, Shift hoặc Super trước, rồi mới bấm phím còn lại."

#: settings/ngosen_settings/keys.py
msgid "Firefox and some other apps open their menu bar when Alt is let go."
msgstr "Firefox và vài app khác sẽ mở thanh menu khi thả phím Alt."

#: settings/ngosen_settings/keys.py
msgid "Apps no longer get these keys: Ngó Sen takes them everywhere."
msgstr "Các app sẽ không nhận tổ hợp này nữa: Ngó Sen dùng nó ở mọi nơi."

#: settings/ngosen_settings/options.py
msgid "Switch Between English and Vietnamese"
msgstr "Phím chuyển Anh/Việt"

#: settings/ngosen_settings/options.py
msgid "Mode Menu Hotkey"
msgstr "Phím tắt menu chế độ gõ"

#: settings/ngosen_settings/options.py
msgid "Cycle Mode Hotkey"
msgstr "Phím tắt chuyển nhanh chế độ"

#: settings/ngosen_settings/options.py
msgid "Mode Order"
msgstr "Thứ tự chế độ"

#: settings/ngosen_settings/options.py
msgid "Show Sen"
msgstr "Hiển thị chế độ Gõ Sen"

#: settings/ngosen_settings/options.py
msgid "Show Preedit"
msgstr "Hiển thị chế độ Gạch chân"

#: settings/ngosen_settings/options.py
msgid "Show OFF"
msgstr "Hiển thị chế độ Tắt"

#: settings/ngosen_settings/options.py
msgid "Show Vim mode"
msgstr "Hiển thị Vim mode"

#: settings/ngosen_settings/options.py
msgid "Interface Language"
msgstr "Ngôn ngữ giao diện"

#: settings/ngosen_settings/options.py
msgid "Shortcut for Sen"
msgstr "Phím tắt cho Gõ Sen"

#: settings/ngosen_settings/options.py
msgid "Shortcut for Preedit"
msgstr "Phím tắt cho Gạch chân"

#: settings/ngosen_settings/options.py
msgid "Shortcut for OFF"
msgstr "Phím tắt cho Tắt"

#: settings/ngosen_settings/options.py
msgid "Shortcut for Vim mode"
msgstr "Phím tắt cho Vim mode"

#: settings/ngosen_settings/options.py
msgid "Mode"
msgstr "Chế độ gõ"

#: settings/ngosen_settings/options.py
msgid "Output Charset"
msgstr "Bảng mã"

#: settings/ngosen_settings/options.py
msgid "Custom Keymap"
msgstr "Keymap tuỳ chỉnh"

#: settings/ngosen_settings/options.py
msgid "Enable Spell Check Using Dictionary"
msgstr "Kiểm tra chính tả"

#: settings/ngosen_settings/options.py
msgid "Key to Keep the Word as Typed"
msgstr "Phím chốt chữ"

#: settings/ngosen_settings/options.py
msgid "Allow dd To Produce đ When Auto Restore Invalid Words Is On"
msgstr "Vẫn gõ dd ra đ khi tự khôi phục"

#: settings/ngosen_settings/options.py
msgid "Use oà, uý (Instead Of òa, úy)"
msgstr "Bỏ dấu kiểu mới (oà, uý)"

#: settings/ngosen_settings/options.py
msgid "Allow Type With More Freedom"
msgstr "Gõ tự do"

#: settings/ngosen_settings/options.py
msgid "Backspace Removes the Tone Mark"
msgstr "Backspace xoá dấu thanh"

#: settings/ngosen_settings/options.py
msgid "Change the tone of a typed word"
msgstr "Cứu dấu: sửa dấu chữ đã gõ"

#: settings/ngosen_settings/options.py
msgid "Retype text typed before switching on"
msgstr "Cứu chữ: gõ lại có dấu khi quên bật tiếng Việt"

#: settings/ngosen_settings/options.py
msgid "Type w to Produce ư"
msgstr "Gõ w ra ư"

#: settings/ngosen_settings/options.py
msgid "Type [ -> ơ, ] -> ư, { -> Ơ, } -> Ư"
msgstr "Phím [ ] ra ơ ư"

#: settings/ngosen_settings/options.py
msgid "Auto capitalize after sentence-ending punctuation (. ! ? Enter)"
msgstr "Tự viết hoa đầu câu (thử nghiệm)"

#: settings/ngosen_settings/options.py
msgid "Capitalize the first letter of the text or of a line"
msgstr "Tự viết hoa chữ đầu văn bản và đầu dòng (thử nghiệm)"

#: settings/ngosen_settings/options.py
msgid "Double Space to Period"
msgstr "Hai dấu cách thành dấu chấm (thử nghiệm)"

#: settings/ngosen_settings/options.py
msgid "Double Hyphen to Em-Dash (--)"
msgstr "Hai gạch nối thành gạch dài"

#: settings/ngosen_settings/options.py
msgid "Enable Macro"
msgstr "Bật gõ tắt"

#: settings/ngosen_settings/options.py
msgid "Macros while typing English"
msgstr "Gõ tắt cả khi đang gõ tiếng Anh"

#: settings/ngosen_settings/options.py
msgid "Time Format ($TIME in macro)"
msgstr "Định dạng giờ ($TIME trong gõ tắt)"

#: settings/ngosen_settings/options.py
msgid "Date Format ($DATE in macro)"
msgstr "Định dạng ngày ($DATE trong gõ tắt)"

#: settings/ngosen_settings/options.py
msgid "Opens a menu to pick Sen, underlined typing or Off for the app in use. Press it twice to type the key itself; while typing English it types as usual."
msgstr "Mở menu để chọn Gõ Sen, gạch chân hay Tắt cho app đang dùng. Bấm hai lần để gõ ra chính phím đó; lúc gõ tiếng Anh phím gõ như thường."

#: settings/ngosen_settings/options.py
msgid "Moves the app in use to the next mode in the list below, and remembers it for that app."
msgstr "Chuyển app đang dùng sang chế độ kế tiếp trong danh sách bên dưới và nhớ cho app đó."

#: settings/ngosen_settings/options.py
msgid "Keep Unicode unless an old document or app needs another one, such as TCVN3 (ABC)."
msgstr "Cứ để Unicode, trừ khi văn bản hay app cũ cần bảng mã khác như TCVN3 (ABC)."

#: settings/ngosen_settings/options.py
msgid "The keys below, used when the input method is Custom."
msgstr "Các phím bên dưới, dùng khi kiểu gõ là Custom."

#: settings/ngosen_settings/options.py
msgid "Words that are not Vietnamese get no tone marks."
msgstr "Từ không phải tiếng Việt thì không thêm dấu."

#: settings/ngosen_settings/options.py
msgid "Check spelling against the list below. Off: the list that comes with Ngó Sen."
msgstr "Kiểm chính tả theo danh sách bên dưới. Tắt: dùng danh sách có sẵn của Ngó Sen."

#: settings/ngosen_settings/options.py
msgid "Typing windows still gives windows."
msgstr "Gõ windows vẫn ra windows."

#: settings/ngosen_settings/options.py
msgid "Tap the key alone to keep the word as shown: tunx, Ctrl → tũn, with no restore or macro. Alt also shows the menu bar in some apps."
msgstr "Bấm rồi thả riêng phím để giữ nguyên từ: tunx, Ctrl → tũn, không khôi phục hay bung macro. Alt còn hiện thanh menu ở một số app."

#: settings/ngosen_settings/options.py
msgid "dd and Space stays đ instead of going back to dd."
msgstr "Gõ dd rồi dấu cách vẫn ra đ, không bị trả về dd."

#: settings/ngosen_settings/options.py
msgid "hoà, khoẻ, thuý, tuỳ. Off: hòa, khỏe, thúy, tùy."
msgstr "hoà, khoẻ, thuý, tuỳ. Tắt: hòa, khỏe, thúy, tùy."

#: settings/ngosen_settings/options.py
msgid "Tone marks can also go at the end of the word."
msgstr "Gõ dấu ở cuối từ cũng được."

#: settings/ngosen_settings/options.py
msgid "z in Telex (0 in VNI) removes the tone mark even with this off. On a word without one, Backspace deletes as usual."
msgstr "Kể cả khi tắt mục này, phím z (Telex) hay 0 (VNI) vẫn xoá dấu thanh. Chữ không có dấu thanh thì Backspace xoá chữ như thường."

#: settings/ngosen_settings/options.py
msgid "Click right after chao, or select it in an X11 app, and type f to get chào. Only when typing with Sen; Tab or Esc puts the key back."
msgstr "Bấm chuột ngay sau chao (hay bôi đen chao ở app X11) rồi gõ f để ra chào. Chỉ khi bật Gõ Sen; Tab hay Esc trả lại phím vừa gõ."

#: settings/ngosen_settings/options.py
msgid "Typed vieetj in English? Switch to Vietnamese and it becomes việt; Tab or Esc puts it back. Where a word may be English on purpose, Enter retypes and Tab or Esc keeps it."
msgstr "Lỡ gõ vieetj lúc tiếng Anh? Chuyển sang tiếng Việt là thành việt; Tab hoặc Esc trả lại. Chữ có thể cố ý gõ tiếng Anh thì Enter để gõ lại, Tab hoặc Esc để giữ."

#: settings/ngosen_settings/options.py
msgid "Non-Start: nhw → như, but w alone stays w. Everywhere: w alone gives ư too. uw always gives ư."
msgstr "Trong từ: nhw → như, còn w đứng riêng vẫn là w. Mọi nơi: w đứng riêng cũng ra ư. uw thì luôn ra ư."

#: settings/ngosen_settings/options.py
msgid "ch]a → chưa, m[f → mờ. Type a bracket twice to get it back: [[ → [."
msgstr "ch]a → chưa, m[f → mờ. Gõ ngoặc hai lần để lấy lại dấu ngoặc: [[ → [."

#: settings/ngosen_settings/options.py
msgid "ban. tooi → ban. Tôi. The same after Enter."
msgstr "ban. tooi → ban. Tôi. Sau Enter cũng vậy."

#: settings/ngosen_settings/options.py
msgid "ban and Space twice gives “ban. ”."
msgstr "Gõ ban rồi hai dấu cách ra “ban. ”."

#: settings/ngosen_settings/options.py
msgid "a--b → a—b."
msgstr "a--b → a—b."

#: settings/ngosen_settings/options.py
msgid "With Enable Macro on, a macro such as ko → không expands even in English."
msgstr "Khi đã bật gõ tắt, từ gõ tắt như ko → không vẫn ra cả khi đang gõ tiếng Anh."

#: settings/ngosen_settings/options.py
msgid "Macros support dynamic placeholders: $TIME and $DATE."
msgstr "Gõ tắt có thể sử dụng giữ chỗ động: $TIME (thời gian hiện tại) và $DATE (ngày hiện tại)."

